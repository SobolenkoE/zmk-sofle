#define ZMK_POINTING_DEFAULT_MOVE_VAL 720

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define AS(keycode) &as LS(keycode) keycode

&mmv_input_listener { input-processors = <&zip_xy_scaler 4 1>; };


&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <2>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };
    behaviors {
        lt_tab: lt_tab {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap";
        };
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
        apos_tap: apos_tap {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp APOS>, <&kp LBKT>, <&kp RBKT>;
        };
        shot_tap: shot_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
            display-name = "Screenshot";
        };
    };
    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };


    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &lt_tab 3 LS(N5) &mmv MOVE_UP &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BACKSPACE
&kp TAB &kp Q &kp W &kp E &kp R &kp T &mmv MOVE_DOWN &kp Y &kp U &kp I &kp O &kp P &kp MINUS
&mt LC(LEFT_SHIFT) ESC &kp A &kp S &kp D &kp F &kp G &mmv MOVE_LEFT &kp H &kp J &kp K &kp L &kp SEMICOLON &apos_tap
&kp LEFT_SHIFT &kp Z &kp X &kp C &kp V &kp B &mmv MOVE_RIGHT &kp N &kp M &kp COMMA &kp PERIOD &kp SLASH &kp RIGHT_SHIFT
&kp C_MUTE &kp LEFT_CONTROL &kp LEFT_GUI &kp LEFT_ALT &lt_tab 1 LG(F1) &mt LEFT_CONTROL SPACE &mkp LCLK &kp SPACE &lt_tab 2 ENTER &lt_tab 4 LG(LS(F1)) &kp LEFT_GUI &kp RIGHT_CONTROL
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "MAIN";
        };

        layer_1 {
            bindings = <
&kp F11 &mt LG(LS(N1)) LG(N1) &mt LG(LS(N2)) LG(N2) &mt LG(LS(N3)) LG(N3) &mt LG(LS(N4)) LG(N4) &mt LG(LS(N5)) LG(N5) &mmv MOVE_UP &mt LG(LS(N6)) LG(N6) &mt LG(LS(N7)) LG(N7) &mt LG(LS(N8)) LG(N8) &mt LG(LS(N9)) LG(N9) &mt LG(LS(N0)) LG(N0) &kp BACKSPACE
&trans &kp LG(Q) &mkp LCLK &mmv MOVE_UP &mkp RCLK &mkp MB4 &mmv MOVE_DOWN &mt LC(HOME) HOME &mt LC(END) END &mt LC(N1) LS(LC(TAB)) &mt LC(N9) LC(TAB) &kp F6 &mt LG(LS(RIGHT)) LG(LS(LEFT))
&trans &shot_tap LG(LS(S)) LG(LA(S)) &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &mkp MB5 &kp LG(LS(LEFT_BRACKET)) &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp LC(T) &kp LS(LC(EQUAL))
&trans &none &kp LG(S) &shot_tap LG(C) LC(C) &shot_tap LG(F) LC(V) &shot_tap LG(E) LG(R) &kp LG(LS(RIGHT_BRACKET)) &mt LG(LS(R)) LG(V) &mt LG(LS(K)) LG(K) &kp END &kp LC(T) &kp LC(W) &kp LC(MINUS)
&kp C_MUTE &trans &trans &trans &trans &trans &mkp LCLK &kp LG(LEFT_CONTROL) &kp LEFT_GUI &trans &trans &trans
            >;

            display-name = "MOVE";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_2 {
            bindings = <
&kp F11 &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &mmv MOVE_UP &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &trans
&trans &kp LS(N1) &kp LS(N2) &kp LS(N3) &kp LS(N4) &kp LS(N5) &mmv MOVE_DOWN &kp LS(N6) &kp LS(N7) &kp LS(N8) &kp LS(N9) &kp LS(N0) &kp LS(EQUAL)
&trans &as LS(N1) N1 &as LS(N2) N2 &as LS(N3) N3 &as LS(N4) N4 &as LS(N5) N5 &mmv MOVE_LEFT &as LS(N6) N6 &as LS(N7) N7 &as LS(N8) N8 &as LS(N9) N9 &as LS(N0) N0 &kp EQUAL
&kp BACKSLASH &kp LS(BACKSLASH) &kp GRAVE &kp LS(GRAVE) &kp LEFT_BRACKET &kp LS(LEFT_BRACKET) &mmv MOVE_RIGHT &kp LS(RIGHT_BRACKET) &kp RIGHT_BRACKET &kp COMMA &kp PERIOD &kp SLASH &trans
&trans &trans &trans &trans &trans &trans &mkp LCLK &trans &trans &trans &trans &trans
            >;

            display-name = "DIGITS";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            bindings = <
&kp LS(GRAVE) &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &mmv MOVE_UP &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &trans
&trans &bt BT_CLR &bt BT_CLR_ALL &trans &trans &trans &mmv MOVE_DOWN &trans &trans &kp F11 &kp F12 &kp MINUS &kp LS(EQUAL)
&trans &rgb_ug RGB_OFF &rgb_ug RGB_ON &rgb_ug 11 &rgb_ug 12 &rgb_ug RGB_HUE &trans &rgb_ug RGB_BRI &rgb_ug RGB_BRD &kp INSERT &kp F11 &kp F12 &trans
&trans &sys_reset &trans &bootloader &trans &trans &mmv MOVE_RIGHT &trans &trans &sys_reset &soft_off &bootloader &trans
&bt BT_CLR &out OUT_USB &out OUT_BLE &trans &trans &trans &mkp LCLK &trans &trans &trans &kp LS(LEFT_BRACKET) &kp LS(RIGHT_BRACKET)
            >;

            display-name = "AJUST";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_4 {
            bindings = <
&none &none &none &none &none &none &none &none &none &none &none &none &none
&none &none &none &none &none &none &none &none &none &none &none &none &kp LG(LS(P))
&none &none &none &none &none &none &none &none &none &none &none &none &none
&none &none &none &none &none &kp LG(B) &none &none &none &none &none &none &none
&none &none &none &none &kp ENTER &none &none &none &none &none &none &none
            >;

            display-name = "MACROS";
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
